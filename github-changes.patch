+name: Python SDK
+
+on:
+  push:
+  pull_request:
+
+permissions:
+  contents: read
+
+jobs:
+  core:
+    runs-on: ${{ matrix.os }}
+    strategy:
+      fail-fast: false
+      matrix:
+        include:
+          - python: "3.10"
+            numpy: "numpy==1.24.4"
+            os: ubuntu-latest
+          - python: "3.11"
+            numpy: "numpy<2"
+            os: ubuntu-latest
+          - python: "3.12"
+            numpy: "numpy>=2"
+            os: ubuntu-latest
+          - python: "3.13"
+            numpy: "numpy>=2"
+            os: ubuntu-latest
+          - python: "3.11"
+            numpy: "numpy>=2"
+            os: windows-latest
+    steps:
+      - uses: actions/checkout@v4
+      - uses: actions/setup-python@v5
+        with:
+          python-version: ${{ matrix.python }}
+          cache: pip
+      - run: python -m pip install -e ".[dev]" "${{ matrix.numpy }}"
+      - run: python -m ruff check .
+      - run: python -m ruff format --check .
+      - run: python -m pytest -q
+      - run: python examples/quantum_programming.py
+      - run: python examples/quantum_learning.py
+      - run: python -m build
+      - name: Install wheel and import away from the source checkout
+        shell: bash
+        run: |
+          python -m pip uninstall -y openqml
+          python -m pip install --no-deps dist/*.whl
+          cd "$(mktemp -d)"
+          python -c "import openqml; assert openqml.bell().run().expectation('ZZ') > 0.999"
+          python -m openqml demo --qubits 40 --shots 16
+      - uses: actions/upload-artifact@v4
+        with:
+          name: distributions-${{ matrix.os }}-py${{ matrix.python }}
+          path: dist/*
+
+  qiskit:
+    runs-on: ubuntu-latest
+    steps:
+      - uses: actions/checkout@v4
+      - uses: actions/setup-python@v5
+        with:
+          python-version: "3.12"
+          cache: pip
+      - run: python -m pip install -e ".[dev,qiskit]"
+      - run: python -m pytest -q tests/test_optimization_interop.py
