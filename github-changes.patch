+def test_classical_baselines_and_parameter_count():
+    features = np.linspace(-np.pi, np.pi, 40)[:, None]
+    targets = np.sin(3 * features[:, 0])
+    model = q.FourierRegressor(harmonics=3, regularization=1e-8).fit(features, targets)
