new file mode 100644
index 0000000..9ae5f8f
--- /dev/null
+++ b/src/openqml/datasets.py
@@ -0,0 +1,151 @@
+"""Offline, seeded toy data and train/test splits; no network request on import."""
+
+import hashlib
+from dataclasses import dataclass, field
+
+import numpy as np
+
+from ._validation import integer, real
+from .models import _features, _labels, _targets
+
+
+@dataclass
+class Dataset:
+    X: np.ndarray
+    y: np.ndarray
+    name: str
+    task_type: str
+    description: str
+    metadata: dict = field(default_factory=dict)
+
+    @property
+    def fingerprint(self):
+        digest = hashlib.sha256()
+        for values in (self.X, self.y):
+            digest.update(str((values.shape, values.dtype.str)).encode())
+            digest.update(np.ascontiguousarray(values).tobytes())
+        return digest.hexdigest()
+
+    def split(self, *, test_size=0.25, seed=1):
+        return train_test_split(
+            self.X,
+            self.y,
+            test_size=test_size,
+            seed=seed,
+            stratify=self.task_type == "classification",
+        )
+
+
+DATASETS = {
+    "xor": ("classification", "Four noisy XOR clusters; a nonlinear toy correctness task."),
+    "circles": ("classification", "Concentric circles; radial separation is classically easy."),
+    "moons": ("classification", "Two noisy interleaving semicircles."),
+    "parity": ("classification", "Uniform bitstrings labeled by global parity; a promise toy."),
+    "sine": ("regression", "A seeded sin(frequency*x) target on [-pi, pi]."),
+    "step": ("regression", "A discontinuous +/-1 target on [-pi, pi]."),
+    "linear": ("regression", "A noisy linear target on [-pi, pi]."),
+}
+
+
+def list_datasets():
+    return [
+        {
+            "id": name,
+            "task_type": kind,
+            "description": description,
+            "source": "openqml synthetic v1",
+            "offline": True,
+        }
+        for name, (kind, description) in DATASETS.items()
+    ]
+
+
+def load_dataset(name="moons", *, n_samples=192, seed=1, noise=0.08, frequency=3, n_features=4):
+    if name not in DATASETS:
+        raise ValueError(f"unknown dataset {name!r}; choose from {', '.join(DATASETS)}")
+    n_samples = integer(n_samples, "n_samples", 8, 100_000)
+    noise = real(noise, "noise")
+    frequency = real(frequency, "frequency")
+    if noise < 0:
+        raise ValueError("noise must be nonnegative")
+    rng = np.random.default_rng(seed)
+    if name in ("xor", "circles", "moons"):
+        y = np.arange(n_samples) % 2
+        if name == "xor":
+            first = rng.integers(0, 2, size=n_samples)
+            second = first ^ y
+            features = np.column_stack([2 * first - 1, 2 * second - 1]).astype(float)
+        else:
+            angles = rng.uniform(0, 2 * np.pi if name == "circles" else np.pi, n_samples)
+            if name == "circles":
+                radius = np.where(y == 0, 1.0, 0.45)
+                features = np.c_[radius * np.cos(angles), radius * np.sin(angles)]
+            else:
+                features = np.c_[np.cos(angles), np.sin(angles)]
+                features[y == 1] = np.c_[1 - np.cos(angles[y == 1]), 0.5 - np.sin(angles[y == 1])]
+        features += rng.normal(0, noise, features.shape)
+    elif name == "parity":
+        n_features = integer(n_features, "n_features", 1, 8)
+        # Guaranteed coverage of both classes before the final shuffle.
+        bits = np.resize(np.arange(1 << n_features), n_samples)
+        rng.shuffle(bits)
+        features = ((bits[:, None] >> np.arange(n_features)) & 1).astype(float)
+        y = (features.sum(axis=1) % 2).astype(int)
+    else:
+        features = rng.uniform(-np.pi, np.pi, (n_samples, 1))
+        x = features[:, 0]
+        y = (
+            np.sin(frequency * x)
+            if name == "sine"
+            else (np.where(x >= 0, 1.0, -1.0) if name == "step" else x / np.pi)
+        )
+        y += rng.normal(0, noise, n_samples)
+    order = rng.permutation(n_samples)
+    kind, description = DATASETS[name]
+    metadata = {
+        "generator": "openqml-synthetic-v1",
+        "seed": seed,
+        "n_samples": n_samples,
+        "noise": noise,
+    }
+    if name == "sine":
+        metadata["frequency"] = frequency
+    if name == "parity":
+        metadata["n_features"] = n_features
+    return Dataset(features[order].copy(), y[order].copy(), name, kind, description, metadata)
+
+
+def train_test_split(features, targets, *, test_size=0.25, seed=1, stratify=False):
+    """Return X_train, X_test, y_train, y_test; inputs are never mutated.
+
+    Stratification allocates a rounded test fraction per class, keeping at least
+    one item on each side. Thus the total may differ slightly from n*test_size.
+    """
+    features = _features(features)
+    labels = (
+        _labels(targets, len(features)) if stratify else _targets_or_labels(targets, len(features))
+    )
+    test_size = real(test_size, "test_size")
+    if not 0 < test_size < 1 or len(features) < 2:
+        raise ValueError("split needs at least two samples and 0 < test_size < 1")
+    rng = np.random.default_rng(seed)
+    if stratify:
+        train, test = [], []
+        for label in np.unique(labels):
+            indices = rng.permutation(np.flatnonzero(labels == label))
+            if indices.size < 2:
+                raise ValueError("stratified splitting needs at least two samples per class")
+            count = max(1, min(len(indices) - 1, int(round(len(indices) * test_size))))
+            test.extend(indices[:count])
+            train.extend(indices[count:])
+        train, test = rng.permutation(train), rng.permutation(test)
+    else:
+        indices = rng.permutation(len(features))
+        count = max(1, min(len(indices) - 1, int(round(len(indices) * test_size))))
+        test, train = indices[:count], indices[count:]
+    return features[train].copy(), features[test].copy(), labels[train].copy(), labels[test].copy()
+
+
+def _targets_or_labels(values, count):
+    values = np.asarray(values)
+    return _labels(values, count) if values.dtype.kind in "US" else _targets(values, count)
diff --git a/src/openqml/exceptions.py b/src/openqml/exceptions.py
new file mode 100644
index 0000000..0d91fc6
--- /dev/null
+++ b/src/openqml/exceptions.py
@@ -0,0 +1,17 @@
+"""Errors shared by the public API."""
+
+
+class OpenQMLError(Exception):
+    """Base error for OpenQML."""
+
+
+class ResourceLimitError(OpenQMLError, RuntimeError):
+    """A requested simulation or readout exceeds an explicit resource budget."""
+
+
+class NotFittedError(OpenQMLError, RuntimeError):
+    """Prediction was requested before fitting a model."""
+
+
+class UnsupportedOperationError(OpenQMLError, ValueError):
+    """An operation is outside an explicitly supported subset."""
diff --git a/src/openqml/hamiltonian.py b/src/openqml/hamiltonian.py
new file mode 100644
index 0000000..6ab0b75
--- /dev/null
+++ b/src/openqml/hamiltonian.py
@@ -0,0 +1,64 @@
+"""Hermitian sums of Pauli strings with explicit little-endian wire semantics."""
+
+from collections.abc import Mapping
+from dataclasses import dataclass
+
+import numpy as np
+
+from ._validation import integer, pauli_string, real
+from .exceptions import ResourceLimitError
+from .simulation import X, Y, Z
+
+
+@dataclass(frozen=True, init=False)
+class Hamiltonian:
+    terms: tuple[tuple[str, float], ...]
+    n_qubits: int
+
+    def __init__(self, terms):
+        """Accept {'ZZ': -1, 'XI': -0.5} or [(pauli_string, coefficient), ...]."""
+        pairs = list(terms.items() if isinstance(terms, Mapping) else terms)
+        if not pairs:
+            raise ValueError("Hamiltonian needs at least one Pauli term")
+        combined = {}
+        width = None
+        for pauli, coefficient in pairs:
+            pauli = pauli_string(pauli, width)
+            width = len(pauli)
+            combined[pauli] = combined.get(pauli, 0) + real(coefficient, "coefficient")
+        object.__setattr__(self, "terms", tuple(combined.items()))
+        object.__setattr__(self, "n_qubits", width)
+
+    def matrix(self, *, max_qubits=10):
+        max_qubits = integer(max_qubits, "max_qubits", 1, 10)
+        if self.n_qubits > max_qubits:
+            raise ResourceLimitError("Exact Hamiltonian matrices are limited to max_qubits <= 10")
+        result = np.zeros((1 << self.n_qubits, 1 << self.n_qubits), complex)
+        for pauli, coefficient in self.terms:
+            term = np.array([[1]], complex)
+            for p in pauli:
+                term = np.kron(term, {"I": np.eye(2), "X": X, "Y": Y, "Z": Z}[p])
+            result += coefficient * term
+        return result
+
+    def ground_energy(self, *, max_qubits=10):
+        return float(np.linalg.eigvalsh(self.matrix(max_qubits=max_qubits))[0])
+
+
+def ising_hamiltonian(n_qubits, *, coupling=1.0, field=1.0, periodic=False):
+    """H = -coupling sum Z_i Z_j - field sum X_i on an open or periodic chain."""
+    n_qubits = integer(n_qubits, "n_qubits", 1, 64)
+    coupling, field = real(coupling, "coupling"), real(field, "field")
+    terms = []
+    edges = [(q, q + 1) for q in range(n_qubits - 1)]
+    if periodic and n_qubits > 2:
+        edges.append((n_qubits - 1, 0))
+    for first, second in edges:
+        label = ["I"] * n_qubits
+        label[-1 - first] = label[-1 - second] = "Z"
+        terms.append(("".join(label), -coupling))
+    for q in range(n_qubits):
+        label = ["I"] * n_qubits
+        label[-1 - q] = "X"
+        terms.append(("".join(label), -field))
+    return Hamiltonian(terms)
diff --git a/src/openqml/interop.py b/src/openqml/interop.py
new file mode 100644
index 0000000..342c8bc
--- /dev/null
+++ b/src/openqml/interop.py
@@ -0,0 +1,229 @@
+"""Strict OpenQASM 2 subset and an optional Qiskit circuit adapter.
+
+Unknown constructs raise an error. Source text is never executed with eval/exec.
+"""
+
+import ast
+import re
+
+import numpy as np
+
+from ._validation import real
+from .circuit import Circuit
+from .exceptions import UnsupportedOperationError
+
+
+def _angle(source):
+    if len(source) > 128:
+        raise ValueError("angle expression is too long")
+    try:
+        tree = ast.parse(source, mode="eval")
+    except SyntaxError as error:
+        raise ValueError("invalid QASM angle expression") from error
+    if sum(1 for _ in ast.walk(tree)) > 32:
+        raise ValueError("angle expression is too complex")
+
+    def visit(node):
+        if isinstance(node, ast.Constant) and isinstance(node.value, (int, float)):
+            return real(node.value, "angle")
+        if isinstance(node, ast.Name) and node.id == "pi":
+            return np.pi
+        if isinstance(node, ast.UnaryOp) and isinstance(node.op, (ast.UAdd, ast.USub)):
+            return visit(node.operand) * (-1 if isinstance(node.op, ast.USub) else 1)
+        if isinstance(node, ast.BinOp) and isinstance(
+            node.op, (ast.Add, ast.Sub, ast.Mult, ast.Div)
+        ):
+            a, b = visit(node.left), visit(node.right)
+            if isinstance(node.op, ast.Add):
+                return real(a + b, "angle")
+            if isinstance(node.op, ast.Sub):
+                return real(a - b, "angle")
+            if isinstance(node.op, ast.Mult):
+                return real(a * b, "angle")
+            if b == 0:
+                raise ValueError("division by zero in angle expression")
+            return real(a / b, "angle")
+        raise UnsupportedOperationError("angles support numbers, pi, +, -, *, /, and parentheses")
+
+    return visit(tree.body)
+
+
+def to_qasm(circuit):
+    """OpenQASM 2 export. Reject noise, feedback, custom gates, and global phase."""
+    lines = ["OPENQASM 2.0;", 'include "qelib1.inc";', f"qreg q[{circuit.n_qubits}];"]
+    measurements = [op for op in circuit._operations if op.name == "measure"]
+    if measurements:
+        lines.append(f"creg c[{len(measurements)}];")
+    index = 0
+    for op in circuit._operations:
+        if op.condition is not None:
+            raise UnsupportedOperationError("QASM 2 subset cannot export classical feedback")
+        if op.name == "measure" and op.basis == "Z":
+            lines.append(f"measure q[{op.wires[0]}] -> c[{index}];")
+            index += 1
+            continue
+        name = op.name
+        if op.controls:
+            if len(op.controls) == 1 and name in ("x", "y", "z", "p"):
+                name = "c" + name
+            elif len(op.controls) == 2 and name == "x":
+                name = "ccx"
+            else:
+                raise UnsupportedOperationError("controlled gate is outside the QASM 2 subset")
+        if name not in {
+            "h",
+            "x",
+            "y",
+            "z",
+            "s",
+            "sdg",
+            "t",
+            "tdg",
+            "rx",
+            "ry",
+            "rz",
+            "p",
+            "cp",
+            "cx",
+            "cy",
+            "cz",
+            "ccx",
+            "swap",
+        }:
+            raise UnsupportedOperationError(f"QASM 2 cannot export operation {op.name!r}")
+        if name in {"p", "cp"}:
+            name = {"p": "u1", "cp": "cu1"}[name]
+        if op.angle is not None:
+            name += f"({op.angle:.17g})"
+        args = ",".join(f"q[{q}]" for q in op.controls + op.wires)
+        lines.append(f"{name} {args};")
+    return "\n".join(lines) + "\n"
+
+
+def from_qasm(source):
+    if not isinstance(source, str) or len(source) > 1_000_000:
+        raise ValueError("QASM source must be a string under one million characters")
+    source = re.sub(r"//[^\n]*", "", source)
+    source = re.sub(r"/\*.*?\*/", "", source, flags=re.S)
+    if source.rstrip() and not source.rstrip().endswith(";"):
+        raise ValueError("QASM statements must end in semicolons")
+    statements = [s.strip() for s in source.split(";") if s.strip()]
+    if not statements or statements[0] != "OPENQASM 2.0":
+        raise UnsupportedOperationError("only the documented OPENQASM 2.0 subset is supported")
+    circuit, register, creg, csize = None, None, None, 0
+    for statement in statements[1:]:
+        if statement == 'include "qelib1.inc"':
+            continue
+        match = re.fullmatch(r"qreg\s+([A-Za-z_]\w*)\[(\d+)\]", statement)
+        if match:
+            if circuit is not None:
+                raise UnsupportedOperationError("only one quantum register is supported")
+            register = match[1]
+            circuit = Circuit(int(match[2]))
+            continue
+        match = re.fullmatch(r"creg\s+([A-Za-z_]\w*)\[(\d+)\]", statement)
+        if match:
+            if creg is not None or int(match[2]) < 1:
+                raise UnsupportedOperationError("one nonempty classical register is supported")
+            creg, csize = match[1], int(match[2])
+            continue
+        if circuit is None:
+            raise ValueError("declare qreg before quantum operations")
+
+        def parse_wires(text):
+            result = []
+            for token in text.split(","):
+                m = re.fullmatch(r"\s*([A-Za-z_]\w*)\[(\d+)\]\s*", token)
+                if not m or m[1] != register or int(m[2]) >= circuit.n_qubits:
+                    raise ValueError(f"invalid wire reference {token!r}")
+                result.append(int(m[2]))
+            return result
+
+        match = re.fullmatch(r"measure\s+(.+?)\s*->\s*([A-Za-z_]\w*)\[(\d+)\]", statement)
+        if match:
+            targets = parse_wires(match[1])
+            if len(targets) != 1 or match[2] != creg or int(match[3]) >= csize:
+                raise ValueError("measurement needs one wire and a declared classical bit")
+            circuit.measure(targets[0], f"{creg}{match[3]}")
+            continue
+        match = re.fullmatch(r"([a-z][a-z0-9]*)\s*(?:\((.*)\))?\s+(.+)", statement)
+        if not match:
+            raise UnsupportedOperationError(f"unsupported QASM statement: {statement!r}")
+        name, angle, target_text = match.groups()
+        targets = parse_wires(target_text)
+        arity = {
+            "h": 1,
+            "x": 1,
+            "y": 1,
+            "z": 1,
+            "s": 1,
+            "sdg": 1,
+            "t": 1,
+            "tdg": 1,
+            "rx": 1,
+            "ry": 1,
+            "rz": 1,
+            "p": 1,
+            "u1": 1,
+            "cp": 2,
+            "cu1": 2,
+            "cx": 2,
+            "cy": 2,
+            "cz": 2,
+            "ccx": 3,
+            "swap": 2,
+        }
+        if name not in arity:
+            raise UnsupportedOperationError(f"unsupported QASM gate: {name!r}")
+        parameterized = name in {"rx", "ry", "rz", "p", "u1", "cp", "cu1"}
+        if len(targets) != arity[name] or (angle is not None) != parameterized:
+            raise ValueError(f"wrong argument count for {name}")
+        method = getattr(circuit, {"u1": "p", "cu1": "cp"}.get(name, name))
+        method(*([_angle(angle)] + targets if parameterized else targets))
+    if circuit is None:
+        raise ValueError("QASM source needs a qreg declaration")
+    return circuit
+
+
+def to_qiskit(circuit):
+    """Return a Qiskit circuit; no account connection or job submission occurs."""
+    try:
+        from qiskit import QuantumCircuit
+        from qiskit.circuit.library import UnitaryGate
+        from qiskit.quantum_info import Kraus
+    except ImportError as error:
+        raise ImportError('Install Qiskit with: python -m pip install "openqml[qiskit]"') from error
+    keys = {
+        op.key: i for i, op in enumerate(op for op in circuit._operations if op.name == "measure")
+    }
+    qc = QuantumCircuit(circuit.n_qubits, len(keys))
+
+    def append(op):
+        if op.name == "measure":
+            q = op.wires[0]
+            if op.basis == "Y":
+                qc.sdg(q)
+            if op.basis != "Z":
+                qc.h(q)
+            qc.measure(q, keys[op.key])
+            if op.basis != "Z":
+                qc.h(q)
+            if op.basis == "Y":
+                qc.s(q)
+        elif op.name == "channel":
+            qc.append(Kraus(list(op.kraus)).to_instruction(), list(op.wires))
+        elif not op.wires:
+            qc.global_phase += op.angle
+        else:
+            gate = UnitaryGate(op.matrix, label=op.label)
+            if op.controls:
+                gate = gate.control(len(op.controls))
+            qc.append(gate, list(op.controls + op.wires))
+
+    for op in circuit._operations:
+        if op.condition is None:
+            append(op)
+        else:
+            with qc.if_test((qc.clbits[keys[op.condition[0]]], op.condition[1])):
+                append(op)
+    return qc
